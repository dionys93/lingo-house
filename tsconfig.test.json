{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // The one difference that matters: tests run in node and touch the disk.
    // `vitest/globals` is deliberately absent — every test imports describe/it
    // explicitly, so the globals are never ambient.
    "types": ["vite/client", "node"]
  },
  "include": ["src/tests"],
  "exclude": []
}
